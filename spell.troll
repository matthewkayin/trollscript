# This is a comment

let spell = {}

spell.name = "Firebolt"
spell.description = "Cast a bolt of fire to burn your foes!"

# All numbers are just float64, yeah?
spell.mana_cost = 5
spell.casts_to_learn = spell.mana_cost * 10
spell.can_target_players = false

let spell_get_damage = func() {
    if spell.mana_cost > 5 {
        return 10
    } else if spell.mana_cost == 5 {
        return 15
    } else {
        return 20
    }
}
func spell_get_damage() {
}

func spell.on_hit() {
}

spell.on_hit = func(target_name) {
    let damage = spell_get_damage()
    # not sure what the best syntax is for string formatting, but it's important
    print("%s took %d damage from the firebolt.", target_name, damage)
}

return spell
